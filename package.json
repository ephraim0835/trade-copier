{
  "name": "trade-copier",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "MT5 Trade Copier - Production SaaS Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "init:owner": "cd apps/api && npm run init:owner",
    "db:migrate": "cd packages/database && npx prisma migrate deploy",
    "db:generate": "cd packages/database && npx prisma generate"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": "20.14.0"
  }
}
