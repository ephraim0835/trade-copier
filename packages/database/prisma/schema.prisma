generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String        @id @default(uuid())
  email               String        @unique
  password            String
  role                Role          @default(USER)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  name                String?
  emailVerified       Boolean       @default(false)
  verificationToken   String?
  resetToken          String?
  resetTokenExpiresAt DateTime?
  accounts            Mt5Account[]
  subscription        Subscription?
}

model Mt5Account {
  id                  String                @id @default(uuid())
  userId              String
  login               String
  broker              String
  server              String
  role                AccountRole
  isActive            Boolean               @default(true)
  isDemo              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  balance             Float?
  currency            String?               @db.VarChar(10)
  equity              Float?
  floatingPl          Float?
  freeMargin          Float?
  margin              Float?
  password            String?
  displayName         String?
  connectionStatus    ConnectionStatus      @default(PENDING)
  provisioningError   String?
  lastHeartbeatAt     DateTime?
  masterSubscriptions AccountSubscription[] @relation("MasterSubscriptions")
  subSubscriptions    AccountSubscription[] @relation("SubSubscriptions")
  auditLogs           AuditLog[]
  copySettings        CopySettings?
  deals               Deal[]
  eaTokens            EaToken[]
  executionCommands   ExecutionCommand[]
  user                User                  @relation(fields: [userId], references: [id])
  orders              Order[]
  positions           Position[]
  tradeCopies         TradeCopy[]
  snapshots           AccountSnapshot[]

  @@unique([login, broker, server])
}

model EaToken {
  id           String     @id @default(uuid())
  mt5AccountId String
  tokenHash    String
  name         String     @default("Default EA Token")
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  mt5Account   Mt5Account @relation(fields: [mt5AccountId], references: [id])
}

model AccountSubscription {
  id              String     @id @default(uuid())
  masterAccountId String
  subAccountId    String
  isActive        Boolean    @default(true)
  riskPercentage  Float?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  masterAccount   Mt5Account @relation("MasterSubscriptions", fields: [masterAccountId], references: [id])
  subAccount      Mt5Account @relation("SubSubscriptions", fields: [subAccountId], references: [id])

  @@unique([masterAccountId, subAccountId])
}

model CopySettings {
  id                       String     @id @default(uuid())
  mt5AccountId             String     @unique
  riskPercentage           Float      @default(1.0)
  roundingTolerancePct     Float      @default(2.0)
  dailyRiskEnabled         Boolean    @default(false)
  maxDailyRisk             Float      @default(0)
  maxTradesEnabled         Boolean    @default(false)
  maxActiveTrades          Int        @default(0)
  requireTp                Boolean    @default(false)
  missingSlTimeoutSec      Int        @default(60)
  maxRecoveryRRDegradation Float      @default(0.5)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  mt5Account               Mt5Account @relation(fields: [mt5AccountId], references: [id])
}

model TradeSignal {
  id             String      @id @default(uuid())
  ticket         BigInt      @unique
  masterAcctId   String
  symbol         String
  type           OrderType
  volume         Float
  priceOpen      Float
  sl             Float       @default(0)
  tp             Float       @default(0)
  time           DateTime
  createdAt      DateTime    @default(now())
  sequenceNumber Int?
  copies         TradeCopy[]
}

model TradeCopy {
  id              String             @id @default(uuid())
  signalId        String
  subAccountId    String
  state           CopyState          @default(WAITING)
  subOrderTicket  BigInt?
  subDealTicket   BigInt?
  subPositionId   BigInt?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  closedVolume    Float              @default(0)
  currentVolume   Float?
  executedVolume  Float?
  remainingVolume Float?
  requestedVolume Float?
  auditLogs       AuditLog[]
  commands        ExecutionCommand[]
  signal          TradeSignal        @relation(fields: [signalId], references: [id])
  subAccount      Mt5Account         @relation(fields: [subAccountId], references: [id])

  @@index([subAccountId])
  @@index([signalId])
  @@index([state])
}

model AuditLog {
  id               String     @id @default(uuid())
  tradeCopyId      String?
  subAccountId     String
  equity           Float
  intendedRisk     Float
  maxPermittedRisk Float
  calculatedVol    Float
  executedVol      Float
  estimatedSlRisk  Float
  roundingDiff     Float
  dailyRiskBefore  Float
  dailyRiskAfter   Float
  decision         CopyState
  rejectionReason  String?
  createdAt        DateTime   @default(now())
  subAccount       Mt5Account @relation(fields: [subAccountId], references: [id])
  tradeCopy        TradeCopy? @relation(fields: [tradeCopyId], references: [id])
}

model Order {
  id           String     @id @default(uuid())
  mt5AccountId String
  ticket       BigInt     @unique
  symbol       String
  type         OrderType
  volume       Float
  filledVolume Float      @default(0)
  price        Float
  state        OrderState
  timeSetup    DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  mt5Account   Mt5Account @relation(fields: [mt5AccountId], references: [id])
}

model Deal {
  id           String     @id @default(uuid())
  mt5AccountId String
  ticket       BigInt     @unique
  orderTicket  BigInt
  positionId   BigInt
  symbol       String
  type         OrderType
  volume       Float
  price        Float
  commission   Float      @default(0)
  swap         Float      @default(0)
  profit       Float      @default(0)
  time         DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  mt5Account   Mt5Account @relation(fields: [mt5AccountId], references: [id])
}

model Position {
  id           String       @id @default(uuid())
  mt5AccountId String
  ticket       BigInt       @unique
  symbol       String
  type         PositionType
  volume       Float
  priceOpen    Float
  sl           Float        @default(0)
  tp           Float        @default(0)
  time         DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  mt5Account   Mt5Account   @relation(fields: [mt5AccountId], references: [id])
}

model ExecutionCommand {
  id                      String        @id @default(uuid())
  tradeCopyId             String
  subAccountId            String
  status                  CommandStatus @default(CREATED)
  type                    CommandType
  masterSignalId          String?
  masterOrderTicket       BigInt?
  masterPositionTicket    BigInt?
  symbol                  String
  orderType               OrderType
  direction               PositionType?
  volume                  Float
  price                   Float?
  sl                      Float?
  tp                      Float?
  magicNumber             BigInt?
  success                 Boolean?
  mt5Retcode              Int?
  retcodeDescription      String?
  orderTicket             BigInt?
  dealTicket              BigInt?
  executedVolume          Float?
  executedPrice           Float?
  requestedPrice          Float?
  brokerError             String?
  comment                 String?
  deliveredAt             DateTime?
  acknowledgedAt          DateTime?
  executedAt              DateTime?
  expiresAt               DateTime
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  backendReceivedAt       DateTime?
  backendResultReceivedAt DateTime?
  commandCreatedAt        DateTime?
  masterEventDetectedAt   DateTime?
  masterEventQueuedAt     DateTime?
  masterEventSentAt       DateTime?
  riskDecisionCompletedAt DateTime?
  subAcknowledgedAt       DateTime?
  subExecutionCompletedAt DateTime?
  subExecutionStartedAt   DateTime?
  subReceivedAt           DateTime?
  subOrderTicket          BigInt?
  subPositionTicket       BigInt?
  subAccount              Mt5Account    @relation(fields: [subAccountId], references: [id])
  tradeCopy               TradeCopy     @relation(fields: [tradeCopyId], references: [id])

  @@index([subAccountId])
  @@index([status])
  @@index([tradeCopyId])
}

model Subscription {
  id                    String             @id @default(uuid())
  userId                String             @unique
  status                SubscriptionStatus @default(TRIAL)
  planId                String?
  stripeCustomerId      String?
  flutterwaveCustomerId String?
  flutterwaveTxRef      String?
  currentPeriodEnd      DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id])
}

model VpsEnvironment {
  id              String   @id @default(uuid())
  name            String   @unique
  status          String   @default("HEALTHY")
  cpuPercent      Float    @default(0)
  ramPercent      Float    @default(0)
  diskPercent     Float    @default(0)
  activeTerminals Int      @default(0)
  lastHeartbeatAt DateTime @default(now())
}

model AccountSnapshot {
  id           String     @id @default(uuid())
  mt5AccountId String
  balance      Float
  equity       Float
  floatingPl   Float      @default(0)
  timestamp    DateTime   @default(now())
  createdAt    DateTime   @default(now())
  mt5Account   Mt5Account @relation(fields: [mt5AccountId], references: [id])

  @@index([mt5AccountId])
  @@index([timestamp])
}

enum Role {
  OWNER
  ADMIN
  USER
}

enum AccountRole {
  MASTER
  SUB
}

enum OrderType {
  BUY
  SELL
  BUY_LIMIT
  SELL_LIMIT
  BUY_STOP
  SELL_STOP
}

enum OrderState {
  STARTED
  PLACED
  CANCELED
  PARTIAL
  FILLED
  REJECTED
  EXPIRED
}

enum PositionType {
  BUY
  SELL
}

enum CommandType {
  OPEN_ORDER
  MODIFY_ORDER
  CLOSE_ORDER
  CLOSE_PARTIAL
}

enum CommandStatus {
  CREATED
  QUEUED
  DELIVERED
  ACKNOWLEDGED
  EXECUTING
  EXECUTED
  REJECTED
  EXECUTION_UNKNOWN
  FAILED
  EXPIRED
}

enum CopyState {
  WAITING_FOR_SL
  APPROVED
  REJECTED
  WAITING
  EXPIRED
  RECOVERING
  EXECUTING
  EXECUTED
  FAILED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  INTERNAL_FREE
}

enum ConnectionStatus {
  PENDING
  PROVISIONING
  ONLINE
  FAILED
  OFFLINE
}
